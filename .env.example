# Copy to .env and uncomment the settings of the provider(s) you use.

# Groq (provider: groq). Create a key at https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key

# Azure AI Foundry / Azure OpenAI (provider: azure_foundry).
# Model names in the experiment configs are deployment names of this resource.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# Optional: without a key, Microsoft Entra ID is used through DefaultAzureCredential (e.g. `az login`).
# AZURE_OPENAI_API_KEY=
# Optional: defaults to 2025-04-01-preview.
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
